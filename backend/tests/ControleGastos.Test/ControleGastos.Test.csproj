<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Nomes de teste no padrão Metodo_Cenario_Resultado -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- Cobertura (coverlet.msbuild): roda com `dotnet test -p:CollectCoverage=true` -->
    <Include>[ControleGastos.Api]*,[ControleGastos.Core]*</Include>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/coverage/</CoverletOutput>
    <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- xunit.v3 sem Microsoft Testing Platform: mantém o VSTest (dotnet test) + coverlet.msbuild -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ControleGastos.Api\ControleGastos.Api.csproj" />
    <ProjectReference Include="..\..\src\ControleGastos.Core\ControleGastos.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- DDL real do Supabase, aplicado no Postgres do Testcontainers -->
    <None Include="..\..\..\supabase-setup.sql" Link="Sql\supabase-setup.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\supabase-migration-categorias-contas-fixas.sql" Link="Sql\supabase-migration-categorias-contas-fixas.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
